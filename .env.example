# ==============================================================================
# Collectibles Monitoring System Configuration (.env.example)
# DO NOT COMMIT ACTUAL SECRETS TO REPOSITORY
# ==============================================================================

# Operating Mode
ENVIRONMENT=development
DRY_RUN=true
STOP_ALL_OUTBOUND=false
LOG_LEVEL=INFO

# Application Core
BASE_CURRENCY=USD
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///collectibles.db

# Provider Credentials (Optional / Sandbox)
CSFLOAT_API_KEY=
STEAM_COMMUNITY_API_KEY=
SKINPORT_CLIENT_ID=
SKINPORT_CLIENT_SECRET=

# Alerting Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_HMAC_SECRET=
